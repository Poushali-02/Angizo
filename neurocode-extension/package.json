{
  "name": "neurocode",
  "displayName": "NeuroCode",
  "description": "AI Accessibility Agent — voice-driven code review, Git workflows, and diff intelligence for blind and low-vision developers.",
  "version": "0.1.0",
  "publisher": "neurocode-team",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "neurocode.startVoiceInput",
        "title": "NeuroCode: Start Voice Input"
      },
      {
        "command": "neurocode.stopVoiceInput",
        "title": "NeuroCode: Stop Voice Input"
      },
      {
        "command": "neurocode.toggleObserver",
        "title": "NeuroCode: Toggle Copilot Observer (Mute/Unmute)"
      },
      {
        "command": "neurocode.announceStatus",
        "title": "NeuroCode: Announce Copilot Observer Status (Screen Reader Hotkey)"
      },
      {
        "command": "neurocode.confirm",
        "title": "NeuroCode: Confirm Action (Yes)"
      },
      {
        "command": "neurocode.cancel",
        "title": "NeuroCode: Cancel Action (No)"
      },
      {
        "command": "neurocode.toggleManualStream",
        "title": "NeuroCode: Toggle Manual Coding Stream"
      }
    ],
    "keybindings": [
      {
        "command": "neurocode.announceStatus",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s"
      },
      {
        "command": "neurocode.confirm",
        "key": "alt+y",
        "mac": "cmd+alt+y"
      },
      {
        "command": "neurocode.cancel",
        "key": "alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "neurocode.toggleManualStream",
        "key": "alt+m",
        "mac": "cmd+alt+m"
      }
    ],
    "configuration": {
      "title": "NeuroCode Configuration",
      "properties": {
        "neurocode.simulateBlindMode": {
          "type": "boolean",
          "default": false,
          "description": "Simulates blind/screen-reader mode for testing .env file access warnings and speech alerts."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.18.1",

    "typescript": "^5.3.0"
  },
  "dependencies": {
    "ws": "^8.16.0"
  }
}
