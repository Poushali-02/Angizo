{
  "name": "neurocode",
  "displayName": "Angizo",
  "description": "AI Accessibility Agent — voice-driven code review, Git workflows, and diff intelligence for blind and low-vision developers.",
  "version": "0.1.0",
  "publisher": "neurocode-team",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "neurocode.startVoiceInput",
        "title": "Angizo: Start Voice Input"
      },
      {
        "command": "neurocode.stopVoiceInput",
        "title": "Angizo: Stop Voice Input"
      },
      {
        "command": "neurocode.toggleObserver",
        "title": "Angizo: Toggle Copilot Observer (Mute/Unmute)"
      },
      {
        "command": "neurocode.announceStatus",
        "title": "Angizo: Announce Copilot Observer Status (Screen Reader Hotkey)"
      },
      {
        "command": "neurocode.confirm",
        "title": "Angizo: Confirm Action (Yes)"
      },
      {
        "command": "neurocode.cancel",
        "title": "Angizo: Cancel Action (No)"
      },
      {
        "command": "neurocode.toggleManualStream",
        "title": "Angizo: Toggle Manual Coding Stream"
      }
    ],
    "keybindings": [
      {
        "command": "neurocode.announceStatus",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s"
      },
      {
        "command": "neurocode.confirm",
        "key": "alt+y",
        "mac": "cmd+alt+y"
      },
      {
        "command": "neurocode.cancel",
        "key": "alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "neurocode.toggleManualStream",
        "key": "alt+m",
        "mac": "cmd+alt+m"
      }
    ],
    "configuration": {
      "title": "Angizo Configuration",
      "properties": {
        "neurocode.simulateBlindMode": {
          "type": "boolean",
          "default": false,
          "description": "Simulates blind/screen-reader mode for testing .env file access warnings and speech alerts."
        },
        "neurocode.backendPort": {
          "type": "number",
          "default": 7001,
          "description": "Port of the Angizo Python backend (ws://localhost:<port>/ws/session)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test:e2e": "npm run compile && node test/e2e/run.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.93.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "ws": "^8.16.0"
  }
}
