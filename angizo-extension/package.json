{
  "name": "angizo",
  "displayName": "Angizo",
  "description": "AI Accessibility Agent — voice-driven code review, Git workflows, and diff intelligence for blind and low-vision developers.",
  "version": "0.1.0",
  "publisher": "angizo-team",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "angizo.runCommand",
        "title": "Angizo: Run a Command…"
      },
      {
        "command": "angizo.toggleMic",
        "title": "Angizo: Start/Stop Listening (Mic)"
      },
      {
        "command": "angizo.startVoiceInput",
        "title": "Angizo: Start Voice Input"
      },
      {
        "command": "angizo.stopVoiceInput",
        "title": "Angizo: Stop Voice Input"
      },
      {
        "command": "angizo.toggleObserver",
        "title": "Angizo: Toggle Copilot Observer (Mute/Unmute)"
      },
      {
        "command": "angizo.announceStatus",
        "title": "Angizo: Announce Copilot Observer Status (Screen Reader Hotkey)"
      },
      {
        "command": "angizo.confirm",
        "title": "Angizo: Confirm Action (Yes)"
      },
      {
        "command": "angizo.cancel",
        "title": "Angizo: Cancel Action (No)"
      },
      {
        "command": "angizo.toggleManualStream",
        "title": "Angizo: Toggle Manual Coding Stream"
      },
      {
        "command": "angizo.showPanel",
        "title": "Angizo: Show Panel"
      }
    ],
    "keybindings": [
      {
        "command": "angizo.toggleMic",
        "key": "ctrl+alt+space",
        "mac": "cmd+alt+space"
      },
      {
        "command": "angizo.announceStatus",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s"
      },
      {
        "command": "angizo.confirm",
        "key": "alt+y",
        "mac": "cmd+alt+y"
      },
      {
        "command": "angizo.cancel",
        "key": "alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "angizo.toggleManualStream",
        "key": "alt+m",
        "mac": "cmd+alt+m"
      }
    ],
    "configuration": {
      "title": "Angizo Configuration",
      "properties": {
        "angizo.simulateBlindMode": {
          "type": "boolean",
          "default": false,
          "description": "Simulates blind/screen-reader mode for testing .env file access warnings and speech alerts."
        },
        "angizo.backendPort": {
          "type": "number",
          "default": 7001,
          "description": "Port of the Angizo Python backend (ws://localhost:<port>/ws/session)."
        }
      }
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "angizo-sidebar",
          "title": "Angizo",
          "icon": "media/cat.svg"
        }
      ]
    },
    "views": {
      "angizo-sidebar": [
        {
          "type": "webview",
          "id": "angizo.view",
          "name": "Angizo"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test:e2e": "npm run compile && node test/e2e/run.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.93.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "ws": "^8.16.0"
  }
}
